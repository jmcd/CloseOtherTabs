{
  "manifest_version": 3,
  "name": "Close Other Tabs",
  "version": "1.0.0",
  "description": "Close all tabs in the current window except the active one.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Close other tabs",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Close other tabs"
    }
  }
}
